# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# LangSmith Tracing & Evaluation (Optional for local dev)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=querypilot-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Database Connection (Read-only role)
DATABASE_URL=postgresql+psycopg2://querypilot_readonly:change_me@localhost:5432/querypilot
DATABASE_DIALECT=postgres
QUERY_TIMEOUT_SECONDS=10
MAX_ROWS=500
MAX_SQL_REPAIR_ATTEMPTS=3
